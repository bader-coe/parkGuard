# Copy this file to .env and edit the values for your machine.
# main.py loads .env automatically when python-dotenv is installed.
# Never commit .env: it may contain local addresses and personal paths.

# --- ESP32 gate controller --------------------------------------------------
# LAN address of the ESP32. Leave empty to run the camera/dashboard without a
# gate controller. Example (documentation range): 192.0.2.10
PARKGUARD_ESP32_IP=
PARKGUARD_ESP32_TIMEOUT_SECONDS=1.5
PARKGUARD_GREETING_SIGNALS=1
PARKGUARD_SERVO_OPEN_ANGLE=90

# Optional USB-serial link to the ESP32. Leave PARKGUARD_SERIAL_PORT empty
# unless you use the serial command interface.
PARKGUARD_SERIAL_PORT=
PARKGUARD_SERIAL_BAUD=115200
PARKGUARD_SERIAL_TIMEOUT=0.5

# --- Dashboard --------------------------------------------------------------
PARKGUARD_HOST=0.0.0.0
PARKGUARD_PORT=5000

# --- Camera and recognition -------------------------------------------------
PARKGUARD_CAMERA_INDEX=0
PARKGUARD_CAMERA_WIDTH=1280
PARKGUARD_CAMERA_HEIGHT=720
PARKGUARD_PREVIEW=1
PARKGUARD_FACE_TOLERANCE=0.45
PARKGUARD_STABILITY_SECONDS=3.0
PARKGUARD_SCAN_TIMEOUT_SECONDS=10.0
PARKGUARD_JPEG_QUALITY=92

# --- Local files ------------------------------------------------------------
PARKGUARD_DB_PATH=park_guard.db
PARKGUARD_CAPTURE_DIR=capture_logs
PARKGUARD_DATASET_DIR=faces
PARKGUARD_ENCODINGS_PICKLE=encodings.pickle

# --- Security policy --------------------------------------------------------
# The first unauthorized attempt only logs. From this attempt onward the
# ESP32 buzzer sounds and lockdown is enabled.
PARKGUARD_BUZZER_AFTER_ATTEMPTS=2

# --- Local text-to-speech ---------------------------------------------------
PARKGUARD_TTS=1
PARKGUARD_TTS_RATE=170
PARKGUARD_TTS_VOLUME=1.0
